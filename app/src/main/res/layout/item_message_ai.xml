<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="48dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/ivAiAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_input_box"
        android:padding="5dp"
        android:src="@drawable/ic_bot"
        app:tint="@color/primary" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_ai_bubble"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvAiContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web|email"
            android:textColor="@color/ai_bubble_text"
            android:textIsSelectable="true"
            android:textSize="14.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAiTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ai_timestamp"
                android:textSize="10.5sp" />

            <!-- Text-to-Speech Button -->
            <ImageButton
                android:id="@+id/btnSpeakAiMessage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_speak"
                android:padding="5dp"
                android:src="@drawable/ic_volume" />

            <!-- Regenerate Button -->
            <ImageButton
                android:id="@+id/btnRegenerateAiMessage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_regenerate"
                android:padding="5dp"
                android:src="@drawable/ic_refresh" />

            <!-- Thumbs Up Button -->
            <ImageButton
                android:id="@+id/btnLikeAiMessage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_like"
                android:padding="5dp"
                android:src="@drawable/ic_thumb_up" />

            <!-- Thumbs Down Button -->
            <ImageButton
                android:id="@+id/btnDislikeAiMessage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_dislike"
                android:padding="5dp"
                android:src="@drawable/ic_thumb_down" />

            <!-- Copy Button -->
            <ImageButton
                android:id="@+id/btnCopyAiMessage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_copy"
                android:padding="5dp"
                android:src="@drawable/ic_copy" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
