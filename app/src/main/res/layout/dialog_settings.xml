<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_provider"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbMockAi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Mock AI (Tự động trả lời, không cần API Key - Khuyên dùng test)"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbGemini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Gemini API (gemini-1.5-flash)"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbOpenAi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenAI API (gpt-4o-mini / gpt-3.5-turbo)"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- API Key Container -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApiKey"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_api_key"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Model Name Container -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilModelName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_model">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtModelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="gemini-1.5-flash"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- System Prompt -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_system_prompt">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtSystemPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lines="3"
                android:text="@string/default_system_prompt"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
